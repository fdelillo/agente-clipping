      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// POST /analyze acepta entre 1 y 100 items por request, así que partimos las\n// menciones nuevas en lotes de a 100. Cada lote sale como un item propio y\n// n8n dispara el HTTP Request una vez por cada uno.\nconst menciones = $input.all().map((item) => ({\n  external_id: item.json.external_id,\n  copy_text: item.json.copy_text,\n}));\n\nconst TAMANO_LOTE = 100;\nconst lotes = [];\nfor (let i = 0; i < menciones.length; i += TAMANO_LOTE) {\n  lotes.push({ json: { items: menciones.slice(i, i + TAMANO_LOTE) } });\n}\n\nreturn lotes;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1568,
          -144
