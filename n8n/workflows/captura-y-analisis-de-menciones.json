      {
        "parameters": {
          "jsCode": "// Un item por combinación de red × tag. n8n itera los nodos siguientes\n// automáticamente, así que 2 providers × 2 tags = 4 llamadas a la API.\nconst tags = ['milei', 'inflacion'];\nconst providers = ['mock_x', 'mock_instagram'];\n\nreturn providers.flatMap((provider) =>\n  tags.map((tag) => ({ json: { provider, tag } }))\n);"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          -144
        ],
