        "name": "Error Trigger"
      },
      {
        "parameters": {
          "jsCode": "// El Error Trigger entrega el contexto crudo de la ejecución que falló.\n// Lo aplanamos a algo legible, para que el archivo sirva sin tener que\n// abrir n8n para entenderlo.\nconst e = $json.execution ?? {};\nconst w = $json.workflow ?? {};\n\nreturn [{\n  json: {\n    ocurrido_en: new Date().toISOString(),\n    workflow: w.name ?? null,\n    ejecucion_id: e.id ?? null,\n    ejecucion_url: e.url ?? null,\n    nodo_que_fallo: e.lastNodeExecuted ?? null,\n    modo: e.mode ?? null,\n    mensaje: e.error?.message ?? null,\n    stack: e.error?.stack ?? null,\n  },\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "id": "19520254-61f1-4c8a-8dc2-6705a0f40bc6",
        "name": "Resumir el error"
      },
